---
import Layout from "../layouts/Layout.astro";
import { COMPANIES, HERO_DEFAULT, satsForPill } from "../data/tape";
import { formatSats, formatBtc, formatYieldPct } from "../lib/sats";

function btcPerShare(btc: number, shares: number): string {
  return (btc / shares).toFixed(5);
}

const payload = COMPANIES.map((c) => ({
  ticker: c.ticker,
  name: c.name,
  hasFdPill: c.hasFdPill,
  fdLabel: c.fdLabel,
  basic: satsForPill(c, "basic"),
  fd: satsForPill(c, "fd"),
  clean: satsForPill(c, "clean"),
  cleanNote: c.cleanNote,
  cleanAsOf: c.cleanAsOf,
  mnavSnapshot: c.mnavSnapshot,
  lastWeek: c.lastWeek
    ? {
        verdict: c.lastWeek.verdict,
        short:
          c.lastWeek.verdict === "accretive"
            ? `+${formatYieldPct(c.lastWeek.yield).replace("+", "")} accretion`
            : c.lastWeek.verdict === "dilutive"
              ? `${formatYieldPct(c.lastWeek.yield)} dilution`
              : "flat",
      }
    : null,
  defaultPill: c.heroDefaultPill,
}));

const initial = payload.find((p) => p.ticker === HERO_DEFAULT.ticker)!;
const initialSats = formatSats(HERO_DEFAULT.sats);
---

<Layout title="btcpershare — Tape" active="tape">
  <div
    class="container"
    id="tape-app"
    data-companies={JSON.stringify(payload)}
    data-default-ticker={HERO_DEFAULT.ticker}
    data-default-pill={HERO_DEFAULT.pill}
  >
    <section class="hero" aria-live="polite">
      <div class="hero-number" id="hero-sats">{initialSats}</div>
      <div class="hero-sub">
        <span class="muted">sats / share for </span>
        <span class="ticker" id="hero-ticker">{"$" + initial.ticker}</span>
      </div>
      <div class="pill-row" role="tablist" aria-label="Share denominator">
        <button type="button" data-pill="basic" id="pill-basic">basic</button>
        <span class="sep">·</span>
        <button type="button" data-pill="fd" id="pill-fd" aria-pressed="true">FD</button>
        <span class="sep">·</span>
        <button type="button" data-pill="clean" id="pill-clean">clean</button>
      </div>
      <div id="hero-verdict" class={`verdict-pill ${initial.lastWeek?.verdict ?? "flat"}`}>
        {initial.lastWeek?.short ?? "flat"}
      </div>
      <p class="clean-note" id="clean-note" hidden></p>
      <h1 class="tagline">Did they stack more Bitcoin than they printed shares?</h1>
      <p class="tagline-sub">Live BTC-per-share tape for treasury companies. Filings in plain English.</p>
    </section>

    <div class="section-head">
      <span><span class="dot"></span>Live treasury tape</span>
      <span><span class="dot live"></span>SEC filings · filing-locked</span>
    </div>

    <div class="tape-list" id="tape-cards">
      {
        COMPANIES.map((c) => (
          <article
            class={`tape-card ${c.ticker === HERO_DEFAULT.ticker ? "selected" : ""}`}
            data-ticker={c.ticker}
            role="button"
            tabindex="0"
          >
            <div class="tape-card-top">
              <div class="company-id">
                <div class="company-icon">{c.ticker.slice(0, 1)}</div>
                <div>
                  <div class="ticker">{c.ticker}</div>
                  <div class="name">{c.name}</div>
                </div>
              </div>
              <div class="activity-pills">
                {c.activities.map((a) => (
                  <span class={`activity ${a.on ? "on" : ""}`}>{a.label}</span>
                ))}
              </div>
            </div>
            <div class="stat-rows">
              <div class="stat-row">
                <span class="k">Bitcoin held</span>
                <span class="v">{formatBtc(c.btc)} BTC</span>
              </div>
              <div class="stat-row">
                <span class="k">sats / share</span>
                <span class="v accent">
                  {formatSats(
                    satsForPill(c, c.ticker === "MSTR" ? "fd" : "basic") ??
                      satsForPill(c, "basic")!,
                  )}
                </span>
              </div>
              {c.ticker === "MSTR" && c.mnavSnapshot != null && (
                <div class="stat-row">
                  <span class="k">mNAV (snapshot)</span>
                  <span class="v" data-mnav>{c.mnavSnapshot.toFixed(2)}x</span>
                </div>
              )}
              {c.pledgedBtc != null && (
                <div class="stat-row">
                  <span class="k">Pledged</span>
                  <span class="v">{formatBtc(c.pledgedBtc)} BTC</span>
                </div>
              )}
            </div>
            {c.lastWeek && (
              <div class={`last-week ${c.lastWeek.verdict}`}>
                Last week: {c.lastWeek.label}
              </div>
            )}
          </article>
        ))
      }
    </div>

    <div class="desktop-table-wrap">
      <table class="desktop-table">
        <thead>
          <tr>
            <th>Company</th>
            <th>Bitcoin held</th>
            <th>sats / share</th>
            <th>Equity activity</th>
            <th>Last week</th>
          </tr>
        </thead>
        <tbody>
          {
            COMPANIES.map((c) => {
              const shares =
                c.ticker === "MSTR" && c.fdShares != null ? c.fdShares : c.basicShares;
              const sats =
                satsForPill(c, c.ticker === "MSTR" ? "fd" : "basic") ??
                satsForPill(c, "basic")!;
              return (
                <tr
                  class={c.ticker === HERO_DEFAULT.ticker ? "selected" : undefined}
                  data-ticker={c.ticker}
                >
                  <td>
                    <div class="company-id">
                      <div class="company-icon">{c.ticker.slice(0, 1)}</div>
                      <div>
                        <div class="ticker">{c.ticker}</div>
                        <div class="name">{c.name}</div>
                      </div>
                    </div>
                  </td>
                  <td>{formatBtc(c.btc)} BTC</td>
                  <td class="sats-cell">
                    <span class="btc-share">{btcPerShare(c.btc, shares)}</span>
                    <span class="sats">{formatSats(sats)} sats</span>
                  </td>
                  <td>
                    <div class="activity-pills">
                      {c.activities.map((a) => (
                        <span class={`activity ${a.on ? "on" : ""}`}>{a.label}</span>
                      ))}
                    </div>
                  </td>
                  <td class={`last-week ${c.lastWeek?.verdict ?? "flat"}`} style="border:none;margin:0;padding-top:1rem;">
                    {c.lastWeek?.verdict === "accretive" &&
                      `+${formatYieldPct(c.lastWeek.yield).replace("+", "")} accretive`}
                    {c.lastWeek?.verdict === "dilutive" &&
                      `${formatYieldPct(c.lastWeek.yield)} dilutive`}
                    {c.lastWeek?.verdict === "flat" && "flat"}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <p class="clean-note" style="margin-top:1rem;">
      Holdings filing-locked (MSTR Aug 30 · ASST Aug 28 · XXI Jun 30 10-Q). Clean / mNAV try live from strategy.com; CORS fallback uses Sep 3 2:50pm ET snapshot.
    </p>
  </div>
</Layout>

<script>
  type CompanyPayload = {
    ticker: string;
    name: string;
    hasFdPill: boolean;
    fdLabel: string | null;
    basic: number | null;
    fd: number | null;
    clean: number | null;
    cleanNote: string | null;
    cleanAsOf: string | null;
    mnavSnapshot: number | null;
    lastWeek: { verdict: string; short: string } | null;
    defaultPill: "basic" | "fd" | "clean";
  };

  const root = document.getElementById("tape-app")!;
  const companies: CompanyPayload[] = JSON.parse(root.dataset.companies || "[]");
  let ticker = root.dataset.defaultTicker || "MSTR";
  let pill = (root.dataset.defaultPill || "fd") as "basic" | "fd" | "clean";

  const heroSats = document.getElementById("hero-sats")!;
  const heroTicker = document.getElementById("hero-ticker")!;
  const heroVerdict = document.getElementById("hero-verdict")!;
  const cleanNote = document.getElementById("clean-note")!;
  const pillButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-pill]"));

  function fmt(n: number) {
    return Math.round(n).toLocaleString("en-US");
  }

  function current() {
    return companies.find((c) => c.ticker === ticker)!;
  }

  function satsOf(c: CompanyPayload, p: typeof pill): number | null {
    if (p === "basic") return c.basic;
    if (p === "fd") return c.hasFdPill ? c.fd : null;
    return c.clean;
  }

  function render() {
    const c = current();
    if (pill === "fd" && !c.hasFdPill) pill = "basic";
    if (pill === "clean" && c.clean == null) pill = c.hasFdPill ? c.defaultPill : "basic";
    if (pill === "clean" && c.defaultPill === "clean") pill = c.hasFdPill ? "fd" : "basic";

    const sats = satsOf(c, pill);
    heroSats.textContent = sats != null ? fmt(sats) : "—";
    heroTicker.textContent = "$" + c.ticker;

    pillButtons.forEach((btn) => {
      const p = btn.dataset.pill as typeof pill;
      const available =
        p === "basic" || (p === "fd" && c.hasFdPill) || (p === "clean" && c.clean != null);
      btn.disabled = !available;
      btn.hidden = p === "fd" && !c.hasFdPill;
      btn.setAttribute("aria-pressed", p === pill && available ? "true" : "false");
      btn.classList.toggle("active", p === pill && available);
      if (p === "fd") btn.textContent = c.fdLabel ? `FD (${c.fdLabel})` : "FD";
    });

    if (c.lastWeek) {
      heroVerdict.className = `verdict-pill ${c.lastWeek.verdict}`;
      heroVerdict.textContent = c.lastWeek.short;
      heroVerdict.hidden = false;
    } else {
      heroVerdict.hidden = true;
    }

    if (pill === "clean" && c.clean != null) {
      cleanNote.hidden = false;
      cleanNote.textContent = `clean snapshot ${c.cleanAsOf ?? ""} — ${c.cleanNote ?? "as-of labeled"}`.trim();
    } else {
      cleanNote.hidden = true;
      cleanNote.textContent = "";
    }

    document.querySelectorAll("[data-ticker]").forEach((el) => {
      el.classList.toggle("selected", (el as HTMLElement).dataset.ticker === ticker);
    });
  }

  pillButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      pill = btn.dataset.pill as typeof pill;
      render();
    });
  });

  function selectTicker(t: string) {
    ticker = t;
    const c = current();
    pill = c.defaultPill;
    // Never default the hero to clean
    if (pill === "clean") pill = c.hasFdPill ? "fd" : "basic";
    render();
  }

  document.querySelectorAll<HTMLElement>("[data-ticker]").forEach((el) => {
    el.addEventListener("click", () => selectTicker(el.dataset.ticker!));
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        selectTicker(el.dataset.ticker!);
      }
    });
  });

  async function tryLiveMnav() {
    const mnavEl = document.querySelector("[data-mnav]");
    if (!mnavEl) return;
    try {
      const res = await fetch("https://www.strategy.com/shares", { mode: "cors" });
      if (!res.ok) throw new Error("status " + res.status);
      const text = await res.text();
      const m = text.match(/mNAV[^0-9]*([0-9]+\.[0-9]+)/i) || text.match(/([0-9]+\.[0-9]+)x/);
      if (m) mnavEl.textContent = Number(m[1]).toFixed(2) + "x (live)";
    } catch {
      const c = companies.find((x) => x.ticker === "MSTR");
      if (c?.mnavSnapshot != null) {
        mnavEl.textContent = c.mnavSnapshot.toFixed(2) + "x · as-of Sep 3 2:50pm ET";
      }
    }
  }

  render();
  tryLiveMnav();
</script>
