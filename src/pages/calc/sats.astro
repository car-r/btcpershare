---
import Layout from "../../layouts/Layout.astro";
import { COMPANIES, satsForPill } from "../../data/tape";
import { formatSats } from "../../lib/sats";

const seed = COMPANIES.map((c) => ({
  ticker: c.ticker,
  name: c.name,
  btc: c.btc,
  basicShares: c.basicShares,
  fdShares: c.fdShares,
  fdLabel: c.fdLabel,
  hasFdPill: c.hasFdPill,
  cleanSats: c.cleanSats,
  basic: satsForPill(c, "basic"),
  fd: satsForPill(c, "fd"),
}));
---
<Layout title="btcpershare — sats/share" active="calc">
  <div class="container" id="sats-calc" data-seed={JSON.stringify(seed)}>
    <h1 class="page-title">sats / share</h1>
    <p class="page-lead">Pills recompute from BTC and share counts. Filing presets load locked numbers.</p>

    <div class="preset-row" id="presets">
      {seed.map((c, i) => (
        <button type="button" class={`preset-btn ${i === 0 ? "active" : ""}`} data-ticker={c.ticker} aria-pressed={i === 0 ? "true" : "false"}>
          {"$" + c.ticker}
        </button>
      ))}
    </div>

    <div class="accretion-layout">
      <div class="panel">
        <h2>Inputs</h2>
        <div class="field">
          <label for="btc">BTC held</label>
          <input id="btc" type="number" inputmode="decimal" />
        </div>
        <div class="field">
          <label for="basicShares">Basic shares</label>
          <input id="basicShares" type="number" inputmode="numeric" />
        </div>
        <div class="field" id="fd-field">
          <label for="fdShares">FD shares <span id="fd-label"></span></label>
          <input id="fdShares" type="number" inputmode="numeric" />
        </div>
      </div>

      <div class="panel">
        <h2>Output</h2>
        <div class="pill-row" style="margin-top:0;margin-bottom:1rem;">
          <button type="button" data-out-pill="basic" aria-pressed="true">basic</button>
          <span class="sep">·</span>
          <button type="button" data-out-pill="fd">FD</button>
          <span class="sep">·</span>
          <button type="button" data-out-pill="clean" disabled title="clean is snapshot-only on tape">clean</button>
        </div>
        <div class="hero-number" id="out-sats" style="font-size:3rem;">—</div>
        <div class="hero-sub"><span class="muted">sats / share</span></div>
        <p class="clean-note" id="out-note"></p>
      </div>
    </div>
  </div>
</Layout>

<script>
  type Seed = {
    ticker: string;
    name: string;
    btc: number;
    basicShares: number;
    fdShares: number | null;
    fdLabel: string | null;
    hasFdPill: boolean;
    cleanSats: number | null;
    basic: number | null;
    fd: number | null;
  };

  const root = document.getElementById("sats-calc")!;
  const seed: Seed[] = JSON.parse(root.dataset.seed || "[]");
  let active = seed[0];
  let outPill: "basic" | "fd" | "clean" = "basic";

  const btcEl = document.getElementById("btc") as HTMLInputElement;
  const basicEl = document.getElementById("basicShares") as HTMLInputElement;
  const fdEl = document.getElementById("fdShares") as HTMLInputElement;
  const fdField = document.getElementById("fd-field")!;
  const fdLabel = document.getElementById("fd-label")!;
  const outSats = document.getElementById("out-sats")!;
  const outNote = document.getElementById("out-note")!;

  function sats(btc: number, shares: number) {
    if (!shares || shares <= 0) return null;
    return Math.round((btc * 100_000_000) / shares);
  }

  function load(c: Seed) {
    active = c;
    btcEl.value = String(c.btc);
    basicEl.value = String(c.basicShares);
    if (c.hasFdPill && c.fdShares != null) {
      fdField.hidden = false;
      fdEl.value = String(c.fdShares);
      fdLabel.textContent = c.fdLabel ? `(${c.fdLabel})` : "";
    } else {
      fdField.hidden = true;
      fdEl.value = "";
      fdLabel.textContent = "";
      if (outPill === "fd") outPill = "basic";
    }
    document.querySelectorAll("#presets .preset-btn").forEach((btn) => {
      const on = (btn as HTMLElement).dataset.ticker === c.ticker;
      btn.classList.toggle("active", on);
      btn.setAttribute("aria-pressed", on ? "true" : "false");
    });
    render();
  }

  function render() {
    const btc = Number(btcEl.value);
    const basicShares = Number(basicEl.value);
    const fdShares = Number(fdEl.value);
    const basic = sats(btc, basicShares);
    const fd = active.hasFdPill ? sats(btc, fdShares) : null;

    document.querySelectorAll<HTMLButtonElement>("[data-out-pill]").forEach((btn) => {
      const p = btn.dataset.outPill as typeof outPill;
      const available = p === "basic" || (p === "fd" && active.hasFdPill) || (p === "clean" && active.cleanSats != null);
      btn.disabled = !available;
      btn.setAttribute("aria-pressed", p === outPill && available ? "true" : "false");
      btn.classList.toggle("active", p === outPill && available);
    });

    let value: number | null = null;
    if (outPill === "basic") value = basic;
    else if (outPill === "fd") value = fd;
    else value = active.cleanSats;

    outSats.textContent = value != null ? value.toLocaleString("en-US") : "—";
    outNote.textContent =
      outPill === "clean" && active.cleanSats != null
        ? "clean is the tape snapshot — not recomputed from these inputs"
        : "";
  }

  document.querySelectorAll("#presets .preset-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const c = seed.find((x) => x.ticker === (btn as HTMLElement).dataset.ticker)!;
      load(c);
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-out-pill]").forEach((btn) => {
    btn.addEventListener("click", () => {
      outPill = btn.dataset.outPill as typeof outPill;
      render();
    });
  });
  [btcEl, basicEl, fdEl].forEach((el) => el.addEventListener("input", render));

  // Fix preset button labels (avoid literal template in SSR text)
  document.querySelectorAll("#presets .preset-btn").forEach((btn) => {
    const t = (btn as HTMLElement).dataset.ticker!;
    btn.textContent = "$" + t;
  });

  load(active);
</script>
